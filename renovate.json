{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "includePaths": [
    ".github/workflows/**",
    ".github/actions/**"
  ],
  "timezone": "Etc/UTC",
  "schedule": [
    "* * * * 1"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Preserve the existing Dependabot grouping policy.",
      "matchPackageNames": [
        "*"
      ],
      "groupName": null
    }
  ],
  "forkProcessing": "enabled",
  "labels": [],
  "semanticCommits": "disabled",
  "commitMessagePrefix": ".github:",
  "automerge": false
}
